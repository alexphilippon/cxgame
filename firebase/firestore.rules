rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Remplace l'adresse ci-dessous par celle du compte administrateur (la même que adminEmail dans js/config.js).
    function isAdmin() { return signedIn() && request.auth.token.email == 'alexandre.philippon@gmail.com'; }

    // Joueurs : chacun gère sa propre fiche (nom, photo). La photo est une petite image JPEG (data URL) ;
    // l'admin peut la retirer et en interdire le renvoi (photoBlocked), ce que le joueur ne peut pas modifier lui-même.
    function photoOk(d) { return !('photo' in d) || d.photo == '' || (d.photo is string && d.photo.size() < 30000 && d.photo.matches('^data:image/jpeg;base64,.*')); }
    match /players/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && !('photoBlocked' in request.resource.data) && photoOk(request.resource.data));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && photoOk(request.resource.data)
        && request.resource.data.get('photoBlocked', false) == resource.data.get('photoBlocked', false)
        && (!resource.data.get('photoBlocked', false) || request.resource.data.get('photo', '') == resource.data.get('photo', '')));
      allow delete: if isAdmin();
    }
    // Adresses e-mail : visibles seulement par l'admin et par leur propriétaire.
    match /contacts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
    // Choix : chacun écrit uniquement les siens. (Le masquage avant la deadline est fait par le site.)
    match /picks/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin());
    }
    // Résultats, calendrier (annulations, reports), alias : admin seulement.
    match /results/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /config/{doc} { allow read: if signedIn(); allow write: if isAdmin(); }
    // Boîte à idées et questions : un joueur connecté écrit ; un visiteur sans compte peut poser une question. Seul l'admin lit.
    match /ideas/{id} {
      allow create: if (signedIn() && request.resource.data.uid == request.auth.uid)
        || (request.resource.data.kind == 'question' && request.resource.data.text is string && request.resource.data.text.size() < 1600);
      allow read, delete: if isAdmin();
    }
    // Messages privés entre deux joueurs : le document de conversation (members = les deux uid triés, id = « uidA_uidB ») et ses messages.
    // Seuls les deux membres lisent ; chacun n'écrit que sous son nom et ne supprime que ses propres messages (l'admin peut supprimer un message signalé).
    function chatMember(cid) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(cid)).data.members; }
    match /chats/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members && request.resource.data.members.size() == 2
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow update: if signedIn() && request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members;
      match /msgs/{mid} {
        allow read: if chatMember(cid);
        allow create: if chatMember(cid) && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600;
        allow delete: if (chatMember(cid) && resource.data.from == request.auth.uid) || isAdmin();
      }
    }
    // Signalements d'un message problématique : un joueur connecté signale (copie du message et du contexte), seul l'admin lit.
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow read, delete: if isAdmin();
    }
    // Coureurs ajoutés : un joueur peut proposer un nom libre (pending), l'admin gère le reste.
    match /athletes/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && request.resource.data.pending == true);
      allow update, delete: if isAdmin();
    }
  }
}
